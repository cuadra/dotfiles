// Matches the current Waybar look
$bg: rgba(0, 0, 0, 1);
$fg: rgba(255, 255, 255, 0.7);
$radius: 7px;
$height: 30px;

window.Bar {
  background: transparent;
}

.bar-body {
  background: $bg;
  border-radius: 0 0 $radius $radius;
  min-height: $height;
  // top, right, bottom, left. The left is smaller because the recording glyph
  // carries extra space on its left, so this makes both ends look even.
  padding: 0 27px 0 18px;
  color: $fg;
  font-family: "Hack Nerd Font", monospace;
  font-size: 14px;
}

.icon {
  font-size: 16px;
  color: $fg;
}

// Bar color for the visualizers (read by the drawing code)
.visualizer {
  color: $fg;
}

// Screen recording indicator (left end of the bar): grey when idle, red while recording
@keyframes rec-pulse {
  0% { opacity: 1; }
  50% { opacity: 0.35; }
  100% { opacity: 1; }
}
.Bar button.recording {
  background: none;
  border: none;
  box-shadow: none;
  padding: 0;
  min-width: 0;
  min-height: 0;
  .icon {
    color: rgba(255, 255, 255, 0.25); // idle: greyed out
    // This glyph sits low in the font; lift it to line up with the other icons.
    // Raise to move it up further, lower to move it down.
    margin-bottom: 3px;
  }
  &:hover .icon {
    color: rgba(255, 255, 255, 0.5);
  }
  &.active .icon {
    color: rgb(248, 113, 113); // recording: pulsing red
    animation: rec-pulse 1.4s ease-in-out infinite;
  }
}

// Mic / speaker icons: click to toggle mute. Flat in every state (no hover,
// press or focus highlight), so they look exactly like plain icons.
.Bar button.audio-toggle {
  &,
  &:hover,
  &:active,
  &:focus,
  &:focus-visible,
  &:checked {
    background: none;
    background-image: none;
    border: none;
    box-shadow: none;
    outline: none;
    // Nerd Font glyphs are drawn wider than the space GTK gives them, so the
    // edges of the icon fell outside the button. Pad the button out to cover
    // the whole glyph, and cancel the padding with a negative margin so the
    // bar layout doesn't move.
    padding: 4px 6px;
    margin: -4px -6px;
    min-width: 0;
    min-height: 0;
  }
  // Muted: same icon, dark grey
  &.muted .icon {
    color: #4a4a4a;
  }
}

.divider {
  margin: 0 4px;
}

// ══ Dashboard (Super+D) ═══════════════════════════════════════════════
// Gauge colors are drawn in code: keep widget/dashboard/theme.ts in sync.
$dash-bg: rgba(16, 16, 24, 0.96);
$dash-card: rgba(255, 255, 255, 0.05);
$dash-border: rgba(255, 255, 255, 0.07);
$dash-text: rgba(255, 255, 255, 0.92);
$dash-sub: rgba(255, 255, 255, 0.62);
$dash-muted: rgba(255, 255, 255, 0.38);
$dash-faint: rgba(255, 255, 255, 0.18);
$dash-purple: rgb(167, 139, 250);
$dash-teal: rgb(94, 214, 200);
$dash-radius: 16px;
$dash-card-radius: 12px;

window.Dashboard {
  background: transparent;
  font-family: "Inter", "Hack Nerd Font", sans-serif; // Nerd Font as fallback for icons
  color: $dash-text;

  // Clean slate for buttons (the GTK theme adds borders/backgrounds)
  button {
    background: none;
    border: none;
    box-shadow: none;
    outline: none;
    padding: 0;
    min-height: 0;
    min-width: 0;
  }
}

// Full-screen dim layer behind the dashboard (no blur: it's cheap to draw).
// Raise the alpha to darken the windows behind it more, lower to lighten.
.backdrop {
  background: rgba(0, 0, 0, 0.7);
}
.dash {
  background: $dash-bg;
  border: 1px solid $dash-border;
  border-radius: $dash-radius;
  padding: 18px;
}
.dash-card {
  background: $dash-card;
  border: 1px solid $dash-border;
  border-radius: $dash-card-radius;
  padding: 16px 18px;
}
.dash-title {
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 1.5px;
  color: $dash-muted;
}
.dash-meta {
  font-size: 11px;
  color: $dash-sub;
}

// ── Time ──
.clock {
  font-size: 64px;
  font-weight: 200;
  letter-spacing: -1px;
  color: $dash-text;
}
.clock-ampm {
  font-size: 18px;
  font-weight: 400;
  color: $dash-purple;
  margin-bottom: 12px;
}
.clock-date {
  font-size: 14px;
  color: $dash-sub;
}
.chips {
  margin-top: 6px;
}
.chip {
  font-size: 11px;
  color: $dash-sub;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid $dash-border;
  border-radius: 999px;
  padding: 3px 10px;
}
.chip-dot {
  font-size: 7px;
  color: $dash-purple;
}

// ── Calendar ──
.cal-title {
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 1.5px;
  color: $dash-sub;
}
window.Dashboard .cal-nav {
  color: $dash-muted;
  font-size: 10px;
  padding: 2px 6px;
  &:hover {
    color: $dash-text;
  }
}
.cal-weekday {
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 1px;
  color: $dash-muted;
}
.cal-day {
  font-size: 13px;
  color: $dash-text;
  min-width: 28px;
  min-height: 28px;
  border-radius: 999px;
  &.weekend {
    color: $dash-sub;
  }
  &.other {
    color: $dash-faint;
  }
  &.today {
    background: $dash-purple;
    color: rgb(20, 18, 30);
    font-weight: 600;
    box-shadow: 0 0 12px rgba(167, 139, 250, 0.55);
  }
}

// ── System ──
.legend {
  font-size: 11px;
  color: $dash-sub;
}
.legend-line {
  min-width: 14px;
  min-height: 3px;
  border-radius: 2px;
  &.load {
    background: $dash-purple;
  }
  &.temp {
    background: $dash-teal;
  }
}
.gauge-value {
  font-size: 17px;
  font-weight: 300;
  color: $dash-text;
}
.gauge-unit {
  font-size: 9px;
  color: $dash-sub;
  margin-bottom: 3px;
}
.gauge-temp {
  font-size: 10px;
  color: $dash-muted;
}
.gauge-label {
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 1.5px;
  color: $dash-sub;
}

// ── Shortcuts ──
window.Dashboard .shortcut {
  min-width: 46px;
  min-height: 46px;
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid $dash-border;
  color: $dash-text;
  font-size: 18px;
  &:hover {
    background: rgba(167, 139, 250, 0.16);
    border-color: rgba(167, 139, 250, 0.4);
  }
}

// Service tiles (Postgres, Docker): dot in the top-right corner, teal while running
.service-dot {
  min-width: 7px;
  min-height: 7px;
  margin: 7px 7px 0 0;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.25);
}
window.Dashboard .shortcut.service {
  &.running {
    color: $dash-teal;
    border-color: rgba(94, 214, 200, 0.45);
    .service-dot {
      background: $dash-teal;
      box-shadow: 0 0 8px rgba(94, 214, 200, 0.8);
    }
  }
  &.starting .service-dot,
  &.stopping .service-dot {
    background: $dash-purple;
    animation: rec-pulse 1s ease-in-out infinite;
  }
}

// ── Connectivity (Wi-Fi / Bluetooth toggles) ──
.toggle-icon {
  font-family: "Hack Nerd Font Mono", "Hack Nerd Font", monospace;
  font-size: 18px;
  min-width: 22px;
  color: $dash-muted;
}
.toggle-row.on .toggle-icon {
  color: $dash-purple;
}
.toggle-name {
  font-size: 13px;
  color: $dash-text;
}
.toggle-status {
  font-size: 11px;
  color: $dash-muted;
}
window.Dashboard switch.toggle {
  background: rgba(255, 255, 255, 0.1);
  border: none;
  box-shadow: none;
  outline: none;
  border-radius: 999px;
  min-width: 40px;
  min-height: 22px;
  padding: 2px;
  &:checked {
    background: $dash-purple;
  }
  &:disabled {
    opacity: 0.35;
  }
  > slider {
    background: white;
    border: none;
    box-shadow: none;
    border-radius: 999px;
    min-width: 18px;
    min-height: 18px;
    margin: 0;
  }
  > image {
    color: transparent; // hide GTK's on/off marks
  }
}

// ── Packages / Network (label + value rows) ──
.info-row {
  min-height: 22px;
}
.info-icon {
  font-family: "Hack Nerd Font Mono", "Hack Nerd Font", monospace;
  font-size: 14px;
  min-width: 20px;
  color: $dash-purple;
  &.off {
    color: $dash-muted;
  }
}
// Row icons in the Packages and Network lists (also sets the row height, so
// both lists line up). Uses the regular (non-Mono) Nerd Font: the Mono
// variant squeezes each glyph into one narrow cell, keeping them small.
window.Dashboard .info-row .info-icon.row-icon {
  font-family: "Hack Nerd Font", "Hack Nerd Font Mono", monospace;
  font-size: 24px;
  min-width: 34px;
  min-height: 32px;
}
// ── Loading indicators (queued / fetching, see lib/scheduler.ts) ──
@keyframes dash-loading {
  0% { opacity: 1; }
  50% { opacity: 0.3; }
  100% { opacity: 1; }
}
// Values being re-read keep their last value and pulse
.info-value.loading,
.loading-text,
.loading .task-desc,
.loading .task-meta {
  animation: dash-loading 1.1s ease-in-out infinite;
}
// "checking updates…" chip
.chip.loading .chip-dot {
  color: $dash-teal;
  animation: dash-loading 0.9s ease-in-out infinite;
}
// Postgres / Docker tiles: purple pulsing dot until the first check lands
window.Dashboard .shortcut.service {
  &.unknown .service-dot,
  &.checking .service-dot {
    background: $dash-purple;
    animation: dash-loading 0.9s ease-in-out infinite;
  }
}

// ── Tasks (Taskwarrior) ──
window.Dashboard .task-check {
  min-width: 16px;
  min-height: 16px;
  margin-top: 2px;
  border-radius: 999px;
  border: 1.5px solid $dash-faint;
  &:hover {
    border-color: $dash-purple;
    background: rgba(167, 139, 250, 0.2);
  }
  &.prio-H {
    border-color: rgb(248, 113, 113);
  }
  &.prio-M {
    border-color: $dash-purple;
  }
  &.done {
    background: $dash-purple;
    border-color: $dash-purple;
  }
}
window.Dashboard .task-open {
  border-radius: 6px;
  padding: 0 4px;
  margin: 0 -4px;
  &:hover {
    background: rgba(255, 255, 255, 0.05);
  }
}
.task-desc {
  font-size: 13px;
  color: $dash-text;
}
.task-meta {
  font-size: 11px;
  color: $dash-muted;
  &.due-soon {
    color: $dash-purple;
  }
  &.overdue {
    color: rgb(248, 113, 113);
  }
}
window.Dashboard .task-all {
  font-size: 11px;
  color: $dash-sub;
  &:hover {
    color: $dash-text;
  }
}

.info-name {
  font-size: 12px;
  color: $dash-sub;
}
.info-value {
  font-size: 12px;
  font-weight: 500;
  color: $dash-text;
}
window.Dashboard .info-copy {
  border-radius: 6px;
  padding: 0 6px;
  margin: 0 -6px; // keep values lined up with the card edge
  &:hover {
    background: rgba(255, 255, 255, 0.05);
    .info-value {
      color: $dash-purple;
    }
  }
}
window.Dashboard .dash-refresh {
  font-family: "Hack Nerd Font Mono", "Hack Nerd Font", monospace;
  font-size: 13px;
  color: $dash-muted;
  padding: 0 2px;
  &:hover {
    color: $dash-text;
  }
  .busy {
    color: $dash-purple;
    animation: rec-pulse 1s ease-in-out infinite;
  }
}

// ── Workspaces + layouts ──
// Free-floating row under the calendar (no card), lined up with the card edges
.ws-row {
  padding: 2px 4px;
}
window.Dashboard .ws-dot {
  min-width: 8px;
  min-height: 8px;
  border-radius: 999px;
  background: $dash-faint;
  &.occupied {
    background: rgba(255, 255, 255, 0.42);
  }
  &.active {
    min-width: 28px;
    background: $dash-purple;
    box-shadow: 0 0 10px rgba(167, 139, 250, 0.5);
  }
  &:hover {
    background: rgba(255, 255, 255, 0.6);
  }
  &.active:hover {
    background: $dash-purple;
  }
}
// Vertical line between the workspace dots and the layout switcher
.ws-divider {
  min-width: 1px;
  min-height: 18px;
  background: $dash-border;
}
.seg {
  background: rgba(0, 0, 0, 0.25);
  border: 1px solid $dash-border;
  border-radius: 10px;
  padding: 3px;
}
window.Dashboard .seg-btn {
  min-width: 28px;
  min-height: 26px;
  border-radius: 7px;
  color: $dash-muted;
  font-size: 13px;
  // Mono Nerd Font sizes each icon to one cell, so it centers in the button
  // (the regular Nerd Font draws these wider than their space, off-center)
  font-family: "Hack Nerd Font Mono", "Hack Nerd Font", monospace;
  &:hover {
    color: $dash-text;
  }
  &.active {
    background: rgba(167, 139, 250, 0.22);
    color: $dash-purple;
  }
}

// ── Audio ──
window.Dashboard .audio-icon {
  min-width: 34px;
  min-height: 34px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid $dash-border;
  color: $dash-sub;
  font-size: 14px;
  &:hover {
    color: $dash-text;
  }
}
.audio-name {
  font-size: 13px;
  color: $dash-text;
}
.audio-value {
  font-size: 11px;
  font-weight: 600;
  color: $dash-text;
}
scale.audio-slider {
  padding: 4px 0;
  > trough {
    background: rgba(255, 255, 255, 0.08);
    border: none;
    border-radius: 999px;
    min-height: 4px;
    > highlight {
      background: $dash-purple;
      border: none;
      border-radius: 999px;
    }
    > slider {
      background: white;
      border: none;
      border-radius: 999px;
      min-width: 14px;
      min-height: 14px;
      margin: -6px 0;
      box-shadow: 0 0 10px rgba(167, 139, 250, 0.8);
    }
  }
}
.audio-row.muted {
  .audio-icon {
    color: rgb(248, 113, 113);
  }
  .audio-value {
    color: $dash-muted;
  }
  scale.audio-slider > trough > highlight {
    background: $dash-faint;
  }
}

// ── App launcher (top of the dashboard) ──
.launcher {
  padding: 10px 14px;
}
.launcher-field {
  background: rgba(0, 0, 0, 0.25);
  border: 1px solid $dash-border;
  border-radius: 10px;
  padding: 4px 10px;
}
.launcher-icon image {
  color: $dash-sub; // tints the symbolic search icon
}
window.Dashboard entry.launcher-entry {
  background: none;
  border: none;
  box-shadow: none;
  outline: none;
  color: $dash-text;
  caret-color: $dash-purple;
  font-size: 14px;
  min-height: 28px;
  padding: 0;
}
.launcher-hint {
  font-size: 12px;
  color: $dash-muted;
}
window.Dashboard .app-chip {
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid $dash-border;
  border-radius: 9px;
  padding: 5px 12px;
  color: $dash-sub;
  font-size: 12px;
  &:hover {
    color: $dash-text;
    background: rgba(255, 255, 255, 0.08);
  }
  &.active {
    background: rgba(167, 139, 250, 0.18);
    border-color: rgba(167, 139, 250, 0.55);
    color: $dash-text;
  }
}
.key {
  font-size: 10px;
  color: $dash-sub;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid $dash-border;
  border-radius: 5px;
  padding: 1px 6px;
}

// ── Notification history (right side of the dashboard) ──
.notif-count {
  font-size: 10px;
  font-weight: 600;
  color: $dash-text;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 999px;
  padding: 0 7px;
}
window.Dashboard .notif-clear {
  font-size: 11px;
  color: $dash-sub;
  border: 1px solid $dash-border;
  border-radius: 7px;
  padding: 3px 10px;
  &:hover {
    color: $dash-text;
    background: rgba(255, 255, 255, 0.06);
  }
}
.notif-item {
  background: rgba(255, 255, 255, 0.035);
  border: 1px solid $dash-border;
  border-radius: 10px;
  padding: 10px 12px;
}
.notif-icon {
  min-width: 30px;
  min-height: 30px;
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.06);
  &.letter {
    font-size: 13px;
    font-weight: 600;
    color: $dash-purple;
    background: rgba(167, 139, 250, 0.15);
  }
}
.notif-app {
  font-size: 11px;
  color: $dash-muted;
}
.notif-time {
  font-size: 10px;
  color: $dash-muted;
  margin-left: 6px;
}
window.Dashboard .notif-dismiss {
  margin-left: 6px;
  font-size: 9px;
  color: $dash-faint;
  &:hover {
    color: $dash-text;
  }
}
.notif-summary {
  font-size: 13px;
  font-weight: 600;
  color: $dash-text;
}
.notif-body {
  font-size: 12px;
  color: $dash-sub;
}
// Thin scrollbar for the history
.notif-panel scrollbar {
  background: none;
  border: none;
  slider {
    background: rgba(255, 255, 255, 0.15);
    border-radius: 999px;
    min-width: 4px;
  }
}

// ══ Notifications ════════════════════════════════════════════════════
// Same look as the bar: solid black, 7px corners, 54px tall
window.Notifications {
  background: transparent;
}
.notification {
  background: $bg;
  border-radius: 0 0 0 $radius;
  min-height: $height;
  padding: 0px 12px 0px 16px;
  color: rgba(255, 255, 255, 0.9);
  font-family: "Hack Nerd Font", monospace;

  .summary {
    font-size: 14px;
  }
  .body {
    font-size: 12px;
    color: $fg;
    margin-top: 2px;
  }
  &.critical {
    border: 1px solid rgb(243, 139, 168);
  }
  .close {
    border: none;
    box-shadow: none;
    min-width: 24px;
    min-height: 24px;
    padding: 0;
    color: $fg;
    font-size: 12px;
    &:hover {
      background: rgba(255, 255, 255, 0.18);
    }
  }
}

// ── Wallpaper preview (bottom of the left column) ──
window.Dashboard .wallpaper {
  border: 1px solid $dash-border;
  border-radius: $dash-card-radius;
  background: $dash-card;
  &:hover {
    border-color: rgba(167, 139, 250, 0.6);
  }
  &:hover .wallpaper-hint {
    opacity: 1;
  }
}
.wallpaper-hint {
  opacity: 0;
  transition: opacity 150ms ease;
  padding: 18px 12px 9px;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.75), transparent);
  font-size: 11px;
  color: $dash-text;
}
.wallpaper-empty {
  font-size: 11px;
  color: $dash-muted;
}

// ── Weather (bottom row, 7-day forecast) ──
.weather-day {
  padding: 10px 0 8px;
  border-radius: 10px;
  &.today {
    background: rgba(167, 139, 250, 0.08);
    .weather-label {
      color: $dash-purple;
    }
  }
}
.weather-label {
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 1px;
  color: $dash-sub;
}
window.Dashboard .weather-icon {
  font-family: "Hack Nerd Font", "Hack Nerd Font Mono", monospace;
  font-size: 30px;
  min-height: 38px;
  color: $dash-sub;
}
.weather-day.sun .weather-icon { color: rgb(250, 204, 21); }
.weather-day.partly .weather-icon { color: rgb(253, 224, 138); }
.weather-day.drizzle .weather-icon,
.weather-day.rain .weather-icon,
.weather-day.pour .weather-icon { color: $dash-teal; }
.weather-day.storm .weather-icon { color: $dash-purple; }
.weather-day.snow .weather-icon,
.weather-day.sleet .weather-icon { color: rgb(186, 230, 253); }
.weather-high {
  font-size: 14px;
  font-weight: 500;
  color: $dash-text;
}
.weather-low {
  font-size: 14px;
  color: $dash-muted;
}

// ── Teams notifications (from Zen) in the dashboard list ──
$teams: rgb(123, 131, 235); // Teams indigo
@keyframes teams-glow {
  0% { box-shadow: 0 0 0 0 rgba(123, 131, 235, 0.75); }
  70% { box-shadow: 0 0 0 7px rgba(123, 131, 235, 0); }
  100% { box-shadow: 0 0 0 0 rgba(123, 131, 235, 0); }
}
.notif-item.teams {
  background: rgba(123, 131, 235, 0.12);
  border: 1px solid rgba(123, 131, 235, 0.55);
  .notif-app {
    color: $teams;
    font-weight: 600;
  }
}
window.Dashboard .notif-icon.teams {
  font-family: "Hack Nerd Font", "Hack Nerd Font Mono", monospace;
  font-size: 20px;
  color: white;
  background: $teams;
  animation: teams-glow 1.8s ease-out infinite;
}

// ── Fans (middle column, under System) ──
.fan {
  background: rgba(255, 255, 255, 0.035);
  border: 1px solid $dash-border;
  border-radius: 10px;
  padding: 8px 12px;
}
window.Dashboard .fan-icon {
  font-family: "Hack Nerd Font", "Hack Nerd Font Mono", monospace;
  font-size: 24px;
  min-width: 30px;
  color: $dash-muted;
}
.fan.running .fan-icon {
  color: $dash-teal;
}
.fan-rpm {
  font-size: 14px;
  font-weight: 500;
  color: $dash-text;
}
.fan.stopped .fan-rpm {
  color: $dash-muted;
}
.fan-name {
  font-size: 11px;
  color: $dash-sub;
}

// ── Camera (left column, above the wallpaper) ──
.camera {
  border: 1px solid $dash-border;
  border-radius: $dash-card-radius;
  background: $dash-card;
  &.live {
    background: black;
  }
  &.busy .camera-icon,
  &.error .camera-icon {
    color: rgb(248, 113, 113);
  }
}
window.Dashboard .camera-icon {
  font-family: "Hack Nerd Font", "Hack Nerd Font Mono", monospace;
  font-size: 24px;
  color: $dash-muted;
}
.camera-message {
  font-size: 11px;
  color: $dash-sub;
}
.camera-badge {
  margin: 8px;
  padding: 2px 8px;
  border-radius: 999px;
  background: rgba(0, 0, 0, 0.55);
  font-size: 9px;
  font-weight: 600;
  letter-spacing: 1px;
  color: $dash-text;
}
.camera-dot {
  font-size: 8px;
  color: rgb(248, 113, 113);
}
